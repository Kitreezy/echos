{
  "sourceLanguage": "ru",
  "strings": {
    "%@ · не отправлено · повторить": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · not sent · retry"
          }
        }
      }
    },
    "%@ · отправляется": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · sending"
          }
        }
      }
    },
    "%@ печатает": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is typing"
          }
        }
      }
    },
    "%@ хочет подключиться к вам. Разрешить?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to connect to you. Allow?"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld непрочитанных": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
