              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld unread"
                }
              }
            }
          }
        },
        "ru": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld непрочитанных"
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld непрочитанных"
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld непрочитанное"
                }
