            "state": "translated",
            "value": "Nearby and via server"
          }
        }
      }
    },
    "Рядом — напрямую между устройствами, без интернета, метров на сто. Через сервер — с кем угодно, где есть сеть; кто рядом, останется рядом.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby — directly between devices, no internet, within about a hundred meters. Via server — with anyone who has a network; people nearby stay nearby."
          }
        }
      }
    },
